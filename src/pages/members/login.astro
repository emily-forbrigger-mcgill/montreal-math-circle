
---
const apiUrl = "https://api.montrealmathcircle.com";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Member Login | Montreal Math Circle</title>
  </head>

  <body>
    <main>
      <h1>Montreal Math Circle</h1>
      <h2>Member Login</h2>
      <p>Enter your assigned username and the member password to continue.</p>

      <form id="login-form">
        <label for="username">Username</label>
        <input
          id="username"
          name="username"
          type="text"
          placeholder="jane.smith.mathcircle"
          autocomplete="username"
          required
        />

        <label for="password">Member password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />

        <button type="submit">Log in</button>
        <p id="message" role="status"></p>
      </form>
    </main>

    <script define:vars={{ apiUrl }}>
      const form = document.querySelector("#login-form");
      const message = document.querySelector("#message");

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        message.textContent = "Signing in...";

        const username = document.querySelector("#username").value.trim();
        const password = document.querySelector("#password").value;

        try {
          const response = await fetch(`${apiUrl}/login`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "include",
            body: JSON.stringify({ username, password }),
          });

          const result = await response.json();

          if (response.ok && result.success) {
            window.location.href = "/members/";
          } else {
            message.textContent =
              result.error || "Login failed. Check your username and password.";
          }
        } catch {
          message.textContent =
            "Unable to connect. Please try again later.";
        }
      });
    </script>
  </body>
</html>
