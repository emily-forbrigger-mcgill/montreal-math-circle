
---
const title = "Members | Montreal Math Circle";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f5f7fa;
        color: #202b3c;
      }

      main {
        max-width: 900px;
        margin: 5vh auto;
        padding: 24px;
      }

      h1 {
        margin-bottom: 8px;
      }

      .subtitle {
        color: #596579;
        margin-bottom: 32px;
      }

      .sections {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }

      .panel {
        background: white;
        border-radius: 12px;
        padding: 26px;
        box-shadow: 0 4px 24px #172b4d12;
      }

      .panel h2 {
        margin-top: 0;
      }

      .panel p {
        line-height: 1.6;
        color: #596579;
      }

      .button {
        display: inline-block;
        background: #203e65;
        color: white;
        padding: 12px 18px;
        border-radius: 6px;
        text-decoration: none;
        margin-top: 8px;
      }

      .button:hover {
        background: #315785;
      }

      .logout-area {
        margin-top: 28px;
      }

      button {
        padding: 10px 16px;
        border: 1px solid #ccd3dd;
        border-radius: 6px;
        background: white;
        cursor: pointer;
      }

      #status:empty {
        display: none;
      }

      @media (max-width: 600px) {
        main {
          margin: 2vh auto;
          padding: 18px;
        }

        .sections {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <h1>Montreal Math Circle</h1>
      <p class="subtitle">Members' area</p>

      <section id="portal" hidden>
        <h2>Welcome, <span id="member-name"></span>!</h2>
        <p>Find discussions, shared resources, and upcoming events below.</p>

        <div class="sections">
          <section class="panel">
            <h2>Discussion Board</h2>
            <p>
              Join conversations, read messages, and keep up with
              Montreal Math Circle announcements.
            </p>
            <a
              class="button"
              href="https://groups.io/g/montrealmathcircle/messages?expanded=1"
              target="_blank"
              rel="noopener noreferrer"
            >
              Discussion Board →
            </a>
          </section>

          <section class="panel">
            <h2>Shared Files</h2>
            <p>
              Find documents, notes, and other resources shared
              with Montreal Math Circle members.
            </p>

            <!-- Add links to your published files here. -->
          </section>

          <section class="panel">
            <h2>Calendar</h2>
            <p>
              View upcoming meetings, activities, and other
              Montreal Math Circle events.
            </p>
            <a
              class="button"
              href="https://groups.io/g/montrealmathcircle/calendar"
              target="_blank"
              rel="noopener noreferrer"
            >
              View Calendar →
            </a>
          </section>
        </div>

        <div class="logout-area">
          <button id="logout" type="button">Sign out</button>
        </div>
      </section>

      <p id="status" role="status" aria-live="polite">
        Checking your sign-in…
      </p>
    </main>

    <script>
      const status = document.querySelector<HTMLElement>("#status")!;
      const portal = document.querySelector<HTMLElement>("#portal")!;
      const memberName = document.querySelector<HTMLElement>("#member-name")!;

      async function checkSession() {
        try {
          const response = await fetch(
            "https://api.montrealmathcircle.com/me",
            { credentials: "include" }
          );

          const result = await response.json();

          if (!response.ok || !result.signedIn) {
            window.location.replace("/members/login");
            return;
          }

          memberName.textContent = result.member.name;
          portal.hidden = false;
          status.textContent = "";
        } catch {
          status.textContent =
            "Unable to verify your sign-in. Please refresh or try again later.";
        }
      }

      document.querySelector<HTMLButtonElement>("#logout")!
        .addEventListener("click", async () => {
          try {
            const response = await fetch(
              "https://api.montrealmathcircle.com/logout",
              {
                method: "POST",
                credentials: "include",
              }
            );

            if (!response.ok) {
              status.textContent = "Sign-out failed. Please try again.";
              return;
            }

            window.location.replace("/members/login");
          } catch {
            status.textContent = "Unable to sign out. Please try again.";
          }
        });

      checkSession();
    </script>
  </body>
</html>


