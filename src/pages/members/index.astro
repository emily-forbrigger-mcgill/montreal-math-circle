
---
const API_BASE = "https://api.montrealmathcircle.com";
---

<svelte:head>
  <title>Members | Montreal Math Circle</title>
</svelte:head>

<main id="members-app" data-api-base={API_BASE}>
  <header class="page-header">
    <h1>Montreal Math Circle Members</h1>
    <p>Shared resources and member account management.</p>
  </header>

  <section id="login-panel" class="panel">
    <h2>Member sign in</h2>
    <form id="login-form">
      <label for="login-username">Username</label>
      <input id="login-username" name="username" autocomplete="username" required />

      <label for="login-password">Password</label>
      <input id="login-password" name="password" type="password"
        autocomplete="current-password" required />

      <button type="submit">Sign in</button>
    </form>
  </section>

  <section id="member-panel" hidden>
    <div class="welcome-row">
      <div>
        <h2>Welcome, <span id="member-name"></span></h2>
        <p id="member-roles"></p>
      </div>
      <button id="logout-button" class="secondary">Sign out</button>
    </div>

    <div id="notice" role="status" aria-live="polite"></div>

    <section class="panel">
      <h2>Shared files</h2>
      <p>Browse files published for members.</p>
      <button id="refresh-files" class="secondary">Refresh files</button>
      <div id="published-files"></div>
    </section>

    <section id="upload-panel" class="panel" hidden>
      <h2>Upload a file</h2>
      <p>Submit a resource for review and publication.</p>

      <form id="upload-form">
        <label for="file-title">Title</label>
        <input id="file-title" name="title" maxlength="200"
          placeholder="A descriptive title" required />

        <label for="file-description">Description (optional)</label>
        <textarea id="file-description" name="description" rows="3"
          maxlength="2000"></textarea>

        <label for="file-input">Choose a file</label>
        <input id="file-input" name="file" type="file" required
          accept=".pdf,.txt,.csv,.rtf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.gif,.webp" />

        <p class="hint">Maximum file size: 20 MB.</p>
        <button type="submit">Upload for review</button>
      </form>
    </section>

    <section id="submissions-panel" class="panel" hidden>
      <h2>File submissions</h2>
      <button id="refresh-submissions" class="secondary">Refresh submissions</button>
      <div id="submissions-list"></div>
    </section>

    <section id="admin-panel" class="panel" hidden>
      <h2>Account management</h2>
      <p>Create member accounts, change permissions, and activate or deactivate accounts.</p>

      <h3>Create a member account</h3>
      <form id="create-account-form">
        <label for="new-name">Member name</label>
        <input id="new-name" name="name" maxlength="200" required />

        <label for="new-username">Username</label>
        <input id="new-username" name="username" maxlength="100"
          autocomplete="off" required />

        <button type="submit">Create account</button>
        <p class="hint">
          New accounts use the member-password setup configured in the Worker.
        </p>
      </form>

      <hr />

      <div class="table-heading">
        <h3>Existing accounts</h3>
        <button id="refresh-members" class="secondary">Refresh accounts</button>
      </div>

      <div id="members-list">
        <p>Loading accounts…</p>
      </div>
    </section>
  </section>
</main>

<style>
  :global(body) {
    margin: 0;
    background: #f5f7fa;
    color: #202b3c;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.55;
  }

  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  h1, h2, h3 {
    line-height: 1.25;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  .panel {
    margin: 1.25rem 0;
    padding: 1.5rem;
    background: white;
    border: 1px solid #dce2ea;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgb(20 40 70 / 4%);
  }

  label {
    display: block;
    margin: 1rem 0 0.35rem;
    font-weight: 650;
  }

  input, textarea, select {
    box-sizing: border-box;
    width: 100%;
    padding: 0.7rem 0.75rem;
    border: 1px solid #b9c4d2;
    border-radius: 7px;
    background: white;
    color: inherit;
    font: inherit;
  }

  input[type="checkbox"] {
    width: auto;
  }

  button {
    margin-top: 1rem;
    padding: 0.7rem 1rem;
    border: 0;
    border-radius: 7px;
    background: #174ea6;
    color: white;
    font: inherit;
    font-weight: 650;
    cursor: pointer;
  }

  button:hover {
    background: #103b80;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  button.secondary {
    background: #e8edf5;
    color: #20324c;
  }

  button.secondary:hover {
    background: #d8e1ef;
  }

  .welcome-row, .table-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  #notice {
    margin: 1rem 0;
    padding: 0;
    border-radius: 7px;
  }

  #notice:not(:empty) {
    padding: 0.8rem 1rem;
    background: #edf3fb;
  }

  #notice.error {
    background: #fff0f0;
    color: #8b1d1d;
  }

  #notice.success {
    background: #edf8ef;
    color: #205b2b;
  }

  .hint, .muted {
    color: #5b687a;
    font-size: 0.92rem;
  }

  .file-item, .submission-item {
    padding: 1rem 0;
    border-top: 1px solid #e0e6ee;
  }

  .file-item:first-child, .submission-item:first-child {
    margin-top: 1rem;
  }

  .item-title {
    font-weight: 700;
  }

  .item-meta {
    color: #596579;
    font-size: 0.9rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .actions button {
    margin-top: 0.5rem;
  }

  .member-card {
    margin: 1rem 0;
    padding: 1rem;
    border: 1px solid #dce2ea;
    border-radius: 8px;
  }

  .member-card h4 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }

  .role-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 0.75rem;
  }

  .role-controls label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-weight: 500;
  }

  .status-active {
    color: #216e35;
    font-weight: 650;
  }

  .status-inactive {
    color: #9a3434;
    font-weight: 650;
  }

  hr {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid #e0e6ee;
  }

  [hidden] {
    display: none !important;
  }
</style>

<script>
  const app = document.querySelector("#members-app");
  const API = app.dataset.apiBase;

  const $ = (selector) => document.querySelector(selector);

  let currentMember = null;
  let currentRoles = {};
  let members = [];

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[char]);
  }

  function notify(message, type = "") {
    const notice = $("#notice");
    notice.textContent = message;
    notice.className = type;
  }

  async function request(path, options = {}) {
    const response = await fetch(`${API}${path}`, {
      credentials: "include",
      ...options,
      headers: {
        ...(options.body instanceof FormData
          ? {}
          : { "Content-Type": "application/json" }),
        ...(options.headers || {})
      }
    });

    const contentType = response.headers.get("content-type") || "";
    const data = contentType.includes("application/json")
      ? await response.json()
      : await response.text();

    if (!response.ok) {
      const message = typeof data === "object" && data
        ? data.error || data.message
        : data;
      throw new Error(message || `Request failed (${response.status})`);
    }

    return data;
  }

  function showSignedOut() {
    currentMember = null;
    currentRoles = {};
    $("#login-panel").hidden = false;
    $("#member-panel").hidden = true;
  }

  function showSignedIn(data) {
    currentMember = data.member;
    currentRoles = data.roles || {};

    $("#login-panel").hidden = true;
    $("#member-panel").hidden = false;
    $("#member-name").textContent = currentMember.name || currentMember.username;

    const roleNames = [];
    if (currentRoles.siteAdministrator) roleNames.push("Site Administrator");
    if (currentRoles.filePublisher) roleNames.push("File Publisher");
    if (currentRoles.fileContributor) roleNames.push("File Contributor");

    $("#member-roles").textContent = roleNames.length
      ? `Your roles: ${roleNames.join(", ")}`
      : "Member access";

    // Administrators can see the upload interface too.
    const canUpload = currentRoles.siteAdministrator ||
      currentRoles.fileContributor || currentRoles.filePublisher;

    $("#upload-panel").hidden = !canUpload;
    $("#submissions-panel").hidden =
      !(currentRoles.siteAdministrator || currentRoles.filePublisher || currentRoles.fileContributor);
    $("#admin-panel").hidden = !currentRoles.siteAdministrator;

    loadFiles();

    if (!$("#submissions-panel").hidden) loadSubmissions();
    if (currentRoles.siteAdministrator) loadMembers();
  }

  async function refreshSession() {
    try {
      const data = await request("/me");
      if (data.signedIn && data.member) {
        showSignedIn(data);
      } else {
        showSignedOut();
      }
    } catch {
      showSignedOut();
    }
  }

  $("#login-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = new FormData(event.currentTarget);

    try {
      notify("Signing in…");
      await request("/login", {
        method: "POST",
        body: JSON.stringify({
          username: form.get("username"),
          password: form.get("password")
        })
      });
      event.currentTarget.reset();
      await refreshSession();
      if (currentMember) notify("You are signed in.", "success");
    } catch (error) {
      notify(error.message || "Sign-in failed.", "error");
    }
  });

  $("#logout-button").addEventListener("click", async () => {
    try {
      await request("/logout", { method: "POST", body: JSON.stringify({}) });
    } catch {
      // Clear the local view even if the session has already expired.
    }
    showSignedOut();
    notify("You have signed out.", "success");
  });

  function formatDate(value) {
    if (!value) return "";
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleDateString();
  }

  function renderFiles(files) {
    const container = $("#published-files");

    if (!Array.isArray(files) || files.length === 0) {
      container.innerHTML = "<p>No published files are available yet.</p>";
      return;
    }

    container.innerHTML = files.map((file) => {
      const title = file.title || file.fileName || file.filename || "Shared file";
      const description = file.description || "";
      const id = encodeURIComponent(file.id);

      return `
        <article class="file-item">
          <div class="item-title">${escapeHtml(title)}</div>
          ${description ? `<p>${escapeHtml(description)}</p>` : ""}
          <p class="item-meta">${escapeHtml(file.fileName || file.filename || "")}
            ${file.createdAt ? ` · Published ${escapeHtml(formatDate(file.createdAt))}` : ""}
          </p>
          <a href="${API}/files/download/${id}" data-download="${id}">Download file</a>
        </article>`;
    }).join("");

    container.querySelectorAll("[data-download]").forEach((link) => {
      link.addEventListener("click", async (event) => {
        event.preventDefault();
        try {
          const response = await fetch(
            `${API}/files/download/${link.dataset.download}`,
            { credentials: "include" }
          );
          if (!response.ok) throw new Error("Could not download this file.");
          const blob = await response.blob();
          const objectUrl = URL.createObjectURL(blob);
          const temporaryLink = document.createElement("a");
          temporaryLink.href = objectUrl;
          temporaryLink.download = "";
          document.body.appendChild(temporaryLink);
          temporaryLink.click();
          temporaryLink.remove();
          URL.revokeObjectURL(objectUrl);
        } catch (error) {
          notify(error.message, "error");
        }
      });
    });
  }

  async function loadFiles() {
    try {
      const data = await request("/files/published");
      renderFiles(Array.isArray(data) ? data : data.files || []);
    } catch (error) {
      $("#published-files").innerHTML =
        `<p>Could not load files: ${escapeHtml(error.message)}</p>`;
    }
  }

  $("#refresh-files").addEventListener("click", loadFiles);

  $("#upload-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const file = $("#file-input").files[0];

    if (!file) {
      notify("Choose a file first.", "error");
      return;
    }

    if (file.size > 20 * 1024 * 1024) {
      notify("The file must be no larger than 20 MB.", "error");
      return;
    }

    const payload = new FormData();
    payload.append("title", $("#file-title").value.trim());
    payload.append("description", $("#file-description").value.trim());
    payload.append("file", file);

    try {
      notify("Uploading file…");
      await request("/files/upload", {
        method: "POST",
        body: payload
      });
      form.reset();
      notify("File uploaded and submitted for review.", "success");
      await loadSubmissions();
    } catch (error) {
      notify(
        `${error.message} If you are a site administrator and upload is denied, the Worker may also need its upload permission check updated.`,
        "error"
      );
    }
  });

  function renderSubmissions(items) {
    const container = $("#submissions-list");

    if (!Array.isArray(items) || items.length === 0) {
      container.innerHTML = "<p>No submissions to display.</p>";
      return;
    }

    container.innerHTML = items.map((item) => {
      const title = item.title || item.fileName || item.filename || "Untitled submission";
      const status = item.status || "pending";
      const canReview = currentRoles.siteAdministrator || currentRoles.filePublisher;
      const id = encodeURIComponent(item.id);

      return `
        <article class="submission-item">
          <div class="item-title">${escapeHtml(title)}</div>
          <p>${escapeHtml(item.description || "")}</p>
          <p class="item-meta">
            Status: ${escapeHtml(status)}
            ${item.createdAt ? ` · Submitted ${escapeHtml(formatDate(item.createdAt))}` : ""}
          </p>
          ${canReview && status === "pending" ? `
            <div class="actions">
              <button type="button" data-review="publish" data-id="${id}">Publish</button>
              <button type="button" class="secondary" data-review="reject" data-id="${id}">Reject</button>
            </div>` : ""}
        </article>`;
    }).join("");

    container.querySelectorAll("[data-review]").forEach((button) => {
      button.addEventListener("click", async () => {
        const action = button.dataset.review;
        const id = button.dataset.id;

        try {
          await request(`/files/submissions/${id}/${action}`, {
            method: "POST",
            body: JSON.stringify({})
          });
          notify(`Submission ${action === "publish" ? "published" : "rejected"}.`, "success");
          await loadSubmissions();
          await loadFiles();
        } catch (error) {
          notify(error.message, "error");
        }
      });
    });
  }

  async function loadSubmissions() {
    try {
      const data = await request("/files/submissions");
      renderSubmissions(Array.isArray(data) ? data : data.submissions || []);
    } catch (error) {
      $("#submissions-list").innerHTML =
        `<p>Could not load submissions: ${escapeHtml(error.message)}</p>`;
    }
  }

  $("#refresh-submissions").addEventListener("click", loadSubmissions);

  $("#create-account-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const name = $("#new-name").value.trim();
    const username = $("#new-username").value.trim();

    try {
      await request("/admin/create-member-account", {
        method: "POST",
        body: JSON.stringify({ name, username })
      });
      event.currentTarget.reset();
      notify(`Account created for ${username}.`, "success");
      await loadMembers();
    } catch (error) {
      notify(error.message, "error");
    }
  });

  async function changeRole(username, role, enabled) {
    const routes = {
      fileContributor: "/admin/set-file-contributor",
      filePublisher: "/admin/set-file-publisher",
      siteAdministrator: "/admin/set-site-administrator"
    };

    await request(routes[role], {
      method: "POST",
      body: JSON.stringify({ username, enabled })
    });
  }

  async function changeActive(username, active) {
    await request("/admin/set-member-active", {
      method: "POST",
      body: JSON.stringify({ username, active })
    });
  }

  function renderMembers(items) {
    const container = $("#members-list");

    if (!Array.isArray(items) || items.length === 0) {
      container.innerHTML = "<p>No member accounts found.</p>";
      return;
    }

    container.innerHTML = items.map((member) => {
      const username = escapeHtml(member.username);
      const active = Boolean(member.active);

      return `
        <article class="member-card" data-username="${username}">
          <h4>${escapeHtml(member.name || member.username)}</h4>
          <p class="item-meta">
            Username: ${username}<br>
            Account created: ${escapeHtml(formatDate(member.createdAt) || "Unknown")}<br>
            Status: <span class="${active ? "status-active" : "status-inactive"}">
              ${active ? "Active" : "Inactive"}
            </span>
          </p>

          <div class="role-controls">
            <label>
              <input type="checkbox" data-role="fileContributor"
                ${member.fileContributor ? "checked" : ""}>
              Contributor
            </label>
            <label>
              <input type="checkbox" data-role="filePublisher"
                ${member.filePublisher ? "checked" : ""}>
              Publisher
            </label>
            <label>
              <input type="checkbox" data-role="siteAdministrator"
                ${member.siteAdministrator ? "checked" : ""}>
              Site Administrator
            </label>
          </div>

          <div class="actions">
            <button type="button" class="secondary" data-active="${active ? "false" : "true"}">
              ${active ? "Deactivate account" : "Activate account"}
            </button>
          </div>
        </article>`;
    }).join("");

    container.querySelectorAll(".member-card").forEach((card) => {
      const username = card.dataset.username;

      card.querySelectorAll("[data-role]").forEach((checkbox) => {
        checkbox.addEventListener("change", async () => {
          const role = checkbox.dataset.role;
          const enabled = checkbox.checked;
          checkbox.disabled = true;

          try {
            await changeRole(username, role, enabled);
            notify(`${roleLabel(role)} ${enabled ? "granted to" : "removed from"} ${username}.`, "success");
            await loadMembers();
          } catch (error) {
            checkbox.checked = !enabled;
            notify(error.message, "error");
          } finally {
            checkbox.disabled = false;
          }
        });
      });

      card.querySelector("[data-active]").addEventListener("click", async (event) => {
        const button = event.currentTarget;
        const active = button.dataset.active === "true";
        button.disabled = true;

        try {
          await changeActive(username, active);
          notify(`Account ${username} ${active ? "activated" : "deactivated"}.`, "success");
          await loadMembers();
        } catch (error) {
          notify(error.message, "error");
        } finally {
          button.disabled = false;
        }
      });
    });
  }

  function roleLabel(role) {
    return {
      fileContributor: "Contributor permission",
      filePublisher: "Publisher permission",
      siteAdministrator: "Site Administrator permission"
    }[role] || role;
  }

  async function loadMembers() {
    const container = $("#members-list");
    container.innerHTML = "<p>Loading accounts…</p>";

    try {
      const data = await request("/admin/list-members");
      members = Array.isArray(data) ? data : data.members || [];
      renderMembers(members);
    } catch (error) {
      container.innerHTML =
        `<p>Could not load member accounts: ${escapeHtml(error.message)}</p>
         <p class="hint">Check that the deployed Worker includes GET /admin/list-members.</p>`;
    }
  }

  $("#refresh-members").addEventListener("click", loadMembers);

  refreshSession();
</script>
</>
