
---
const title = "Members | Montreal Math Circle";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f5f7fa;
        color: #202b3c;
      }
      main {
        max-width: 720px;
        margin: 7vh auto;
        padding: 24px;
      }
      .panel {
        background: white;
        border-radius: 12px;
        padding: 28px;
        margin-top: 24px;
        box-shadow: 0 4px 24px #172b4d12;
      }
      .button {
        display: inline-block;
        background: #203e65;
        color: white;
        padding: 13px 18px;
        border-radius: 6px;
        text-decoration: none;
        margin-top: 12px;
      }
      button {
        padding: 10px 16px;
        border: 1px solid #ccd3dd;
        border-radius: 6px;
        background: white;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Montreal Math Circle</h1>
      <p>Members' area</p>

      <section class="panel" id="portal" hidden>
        <h2>Welcome, <span id="member-name"></span>!</h2>
        <p>
          Visit our Groups.io group to join discussions, read messages,
          and keep up with announcements.
        </p>

        
        <a
          class="button"
          href="https://groups.io/g/montrealmathcircle/messages?expanded=1"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open our Groups.io group →
        </a>


        <p style="margin-top: 24px">
          <button id="logout" type="button">Sign out</button>
        </p>
      </section>

      <p id="status" role="status" aria-live="polite">
        Checking your sign-in…
      </p>
    </main>

    <script>
      const status = document.querySelector<HTMLElement>("#status")!;
      const portal = document.querySelector<HTMLElement>("#portal")!;
      const memberName = document.querySelector<HTMLElement>("#member-name")!;

      async function checkSession() {
        try {
          const response = await fetch(
            "https://api.montrealmathcircle.com/me",
            { credentials: "include" }
          );

          const result = await response.json();

          if (!response.ok || !result.signedIn) {
            window.location.replace("/members/login");
            return;
          }

          memberName.textContent = result.member.name;
          portal.hidden = false;
          status.textContent = "";
        } catch {
          status.textContent =
            "Unable to verify your sign-in. Please refresh or try again later.";
        }
      }

      document.querySelector<HTMLButtonElement>("#logout")!
        .addEventListener("click", async () => {
          try {
            const response = await fetch(
              "https://api.montrealmathcircle.com/logout",
              {
                method: "POST",
                credentials: "include",
              }
            );

            if (!response.ok) {
              status.textContent = "Sign-out failed. Please try again.";
              return;
            }

            window.location.replace("/members/login");
          } catch {
            status.textContent =
              "Unable to sign out. Please try again.";
          }
        });

      checkSession();
    </script>
  </body>
</html>

