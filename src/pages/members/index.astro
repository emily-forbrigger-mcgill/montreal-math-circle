
---
const title = "Members | Montreal Math Circle";
---

<html lang="en">
  <head>
    <!-- Same fonts as the main website -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Mali:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <style>
      :root {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        color: #18181b;
        background: #e6e6fa;
      }

      h1, h2, h3, h4 {
        font-family: 'Mali', cursive, system-ui, sans-serif;
        font-weight: 700;
      }

      button, input, select {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }

      * { box-sizing: border-box; }
      body { margin: 0; }
      main { max-width: 1100px; margin: 4vh auto; padding: 24px; }
      h1 { margin-bottom: 8px; }
      h2 { margin-top: 0; }
      .subtitle { color: #596579; margin-bottom: 28px; }
      .muted { color: #596579; line-height: 1.6; }

      .sections {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }

      .panel {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 24px #172b4d12;
        min-width: 0;
      }

      .panel p { color: #596579; line-height: 1.6; }
      .wide { grid-column: 1 / -1; }

      .button, button {
        display: inline-block;
        background: #203e65;
        color: white;
        padding: 11px 16px;
        border: 0;
        border-radius: 6px;
        text-decoration: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
      }

      .button:hover, button:hover { background: #315785; }
      button:disabled { opacity: .55; cursor: wait; }

      .secondary {
        background: white;
        color: #203e65;
        border: 1px solid #ccd3dd;
      }

      .secondary:hover { background: #edf2f7; }
      .danger { background: #a12828; }
      .danger:hover { background: #821e1e; }
      .field { display: grid; gap: 6px; margin: 14px 0; }
      label { font-size: 14px; font-weight: 600; }

      input, select {
        width: 100%;
        padding: 11px;
        border: 1px solid #ccd3dd;
        border-radius: 6px;
        font: inherit;
        background: white;
      }

      input[type="checkbox"] { width: auto; }

      .checkrow {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 12px 0;
      }

      .checkrow label { font-weight: 400; }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 14px 0;
      }

      .item {
        padding: 14px 0;
        border-top: 1px solid #e1e6ed;
        overflow-wrap: anywhere;
      }

      .item:first-child { border-top: 0; }
      .item-title { font-weight: 700; margin-bottom: 6px; }
      .meta { color: #596579; font-size: 13px; line-height: 1.6; }

      .badge {
        display: inline-block;
        border-radius: 20px;
        background: #edf2f7;
        color: #334155;
        padding: 4px 9px;
        font-size: 12px;
        margin: 3px 0;
      }

      .notice {
        margin: 16px 0;
        padding: 12px;
        border-radius: 6px;
        background: #edf2f7;
        line-height: 1.5;
      }

      .notice:empty { display: none; }
      .logout-area { margin-top: 26px; }
      #status:empty { display: none; }
      .hidden { display: none !important; }
      .small { font-size: 13px; }

      .folder-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 10px;
        margin: 16px 0;
      }

      .folder-tile {
        text-align: left;
        background: #edf2f7;
        color: #203e65;
        border: 1px solid #ccd3dd;
      }

      .folder-tile:hover { background: #dfeaf4; }
      .folder-tile.selected { background: #203e65; color: white; }

      .folder-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
      }

      .folder-controls select { width: auto; max-width: 260px; }
      #folder-form input { max-width: 400px; }
      .folder-heading { margin-top: 22px; }

      /* Compact, clearly separated published documents */

      #published-files .document-card {
        margin: 9px 0;
        padding: 13px 15px;
        border: 1px solid #ddd4eb;
        border-left: 4px solid #ae96d0;
        border-radius: 9px;
        background: #fff;
        transition: background-color .15s, border-color .15s;
      }

      #published-files .document-card:hover {
        background: #fcfaff;
        border-left-color: #a81b24;
      }

      #published-files .document-title {
        font-size: 14px;
        line-height: 1.45;
        font-weight: 700;
        overflow-wrap: anywhere;
      }

      #published-files .document-details {
        margin-top: 3px;
        font-size: 11px;
        line-height: 1.4;
        color: #687488;
      }

      #published-files .document-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin-top: 11px;
        padding-top: 10px;
        border-top: 1px solid #eeeaf4;
      }

      #published-files .document-download {
        padding: 7px 12px;
        font-size: 12px;
        background: #a81b24;
        color: white;
      }

      #published-files .document-download:hover {
        background: #881720;
      }

      #published-files .document-admin-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-left: auto;
      }

      #published-files .document-move-label {
        font-size: 11px;
        color: #687488;
      }

      #published-files .document-folder-select {
        width: auto;
        min-width: 125px;
        max-width: 180px;
        padding: 7px;
        font-size: 12px;
      }

      #published-files .document-delete {
        padding: 7px 11px;
        font-size: 12px;
        color: #a81b24;
        background: white;
        border: 1px solid #e3b4b9;
      }

      #published-files .document-delete:hover {
        background: #fcf1f2;
      }

      @media (max-width: 680px) {
        main { margin: 2vh auto; padding: 16px; }
        .sections { grid-template-columns: 1fr; }
        .wide { grid-column: auto; }
        .panel { padding: 20px; }

        #published-files .document-admin-actions {
          margin-left: 0;
          width: 100%;
        }

        #published-files .document-folder-select {
          flex: 1;
          max-width: none;
        }
      }
    
      /* Important Links section */

      .links-list {
        display: grid;
        gap: 10px;
        margin-top: 14px;
      }

      .link-entry {
        border: 1px solid #ded7ed;
        border-left: 4px solid #ad96cc;
        border-radius: 9px;
        padding: 13px 15px;
        min-width: 0;
      }

      .link-entry a {
        color: #a81b24;
        font-weight: 700;
        text-decoration: none;
        overflow-wrap: anywhere;
      }

      .link-entry a:hover {
        text-decoration: underline;
      }

      .link-description {
        color: #64748b;
        font-size: 12px;
        margin-top: 5px;
        line-height: 1.5;
      }

      .link-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 10px;
      }

      .link-actions button {
        padding: 6px 10px;
        font-size: 12px;
      }

      #links-admin {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #e8e0f1;
      }

      #links-form {
        max-width: 650px;
      }

      #links-form textarea {
        width: 100%;
        min-height: 72px;
        resize: vertical;
        padding: 11px;
        border: 1px solid #ccd3dd;
        border-radius: 6px;
        font: inherit;
      }

      .link-form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

    </style>
  </head>

  <body>
    <main>
      <h1>Montreal Math Circle</h1>
      <p class="subtitle">Members' area</p>

      <p id="status" class="notice" role="status" aria-live="polite">
        Checking your sign-in…
      </p>

      <section id="portal" class="hidden">
        <h2>Welcome, <span id="member-name"></span>!</h2>
        <p id="role-summary" class="muted"></p>

        <div class="sections">
          <section class="panel">
            <h2>Discussion Board</h2>
            <p>Join conversations, read messages, and keep up with Montreal Math Circle announcements.</p>
            <a class="button" href="https://groups.io/g/montrealmathcircle/messages?expanded=1" target="_blank" rel="noopener noreferrer">Discussion Board →</a>
          </section>

          <section class="panel">
            <h2>Calendar</h2>
            <p>View upcoming meetings, activities, and other Montreal Math Circle events.</p>
            <a class="button" href="https://groups.io/g/montrealmathcircle/calendar" target="_blank" rel="noopener noreferrer">View Calendar →</a>
          </section>
           
          <!-- Important Links: visible to all signed-in members -->
          <section class="panel wide" id="important-links-panel">
            <h2>Important Links</h2>
            <p>Useful websites and resources for Montreal Math Circle members.</p>

            <div
              id="important-links-list"
              class="links-list"
              aria-live="polite"
            >
              Loading links…
            </div>

            <!-- Only administrators will see these controls -->
            <div id="links-admin" class="hidden">
              <h3 id="links-form-heading">Add an Important Link</h3>

              <form id="links-form">
                <div class="field">
                  <label for="link-title">Link title</label>
                  <input
                    id="link-title"
                    maxlength="120"
                    required
                    placeholder="e.g. Competition Resources"
                  />
                </div>

                <div class="field">
                  <label for="link-url">Website address</label>
                  <input
                    id="link-url"
                    type="url"
                    maxlength="2048"
                    required
                    placeholder="https://example.com"
                  />
                </div>

                <div class="field">
                  <label for="link-description">
                    Description (optional)
                  </label>
                  <textarea
                    id="link-description"
                    maxlength="300"
                    placeholder="A short description of this resource"
                  ></textarea>
                </div>

                <div class="link-form-actions">
                  <button id="save-link-button" type="submit">
                    Add link
                  </button>

                  <button
                    id="cancel-link-edit"
                    type="button"
                    class="secondary hidden"
                  >
                    Cancel edit
                  </button>
                </div>
              </form>

              <div
                id="links-status"
                class="notice"
                role="status"
                aria-live="polite"
              ></div>
            </div>
          </section>
           
          <!-- Member Directory -->
          <section class="panel wide" id="member-directory-panel">
            <h2>Member Directory</h2>
            <p>Contact information for Montreal Math Circle members.</p>

            <div
              id="directory-list"
              class="links-list"
              aria-live="polite"
            >
              Loading member directory…
            </div>

            <!-- Administrator-only editing controls -->
            <div id="directory-admin" class="hidden">
              <h3 id="directory-form-heading">Add a Directory Member</h3>

              <form id="directory-form">
                <div class="field">
                  <label for="directory-name">Full name</label>
                  <input
                    id="directory-name"
                    required
                    maxlength="120"
                  />
                </div>

                <div class="field">
                  <label for="directory-role">Role or position (optional)</label>
                  <input id="directory-role" maxlength="120" />
                </div>

                <div class="field">
                  <label for="directory-email">Email (optional)</label>
                  <input
                    id="directory-email"
                    type="email"
                    maxlength="254"
                  />
                </div>

                <div class="field">
                  <label for="directory-phone">Phone (optional)</label>
                  <input id="directory-phone" type="tel" maxlength="60" />
                </div>

                <div class="field">
                  <label for="directory-description">
                    Short description (optional)
                  </label>
                  <textarea
                    id="directory-description"
                    maxlength="500"
                    rows="3"
                    style="width:100%; padding:11px; border:1px solid #ccd3dd; border-radius:6px; font:inherit;"
                  ></textarea>
                </div>

                <div class="link-form-actions">
                  <button id="directory-save" type="submit">
                    Add member
                  </button>

                  <button
                    id="directory-cancel"
                    type="button"
                    class="secondary hidden"
                  >
                    Cancel edit
                  </button>
                </div>
              </form>

              <div
                id="directory-status"
                class="notice"
                role="status"
                aria-live="polite"
              ></div>
            </div>
          </section>



          <section class="panel wide">
            <h2>Shared Files</h2>
            <p>Published documents and resources available to signed-in members.</p>

            <div class="toolbar">
              <button id="refresh-files" type="button">Refresh files</button>
            </div>

            <div id="folder-admin" class="hidden">
              <h3>Manage Document Folders</h3>

              <form id="folder-form" class="toolbar">
                <label for="folder-name">New folder name</label>
                <input id="folder-name" maxlength="80" required placeholder="e.g. Number Theory" />
                <button type="submit">Create folder</button>
              </form>

              <div id="folder-status" class="notice" role="status" aria-live="polite"></div>
            </div>

            <div id="folder-navigation" class="folder-grid" aria-label="Document folders"></div>
            <div id="published-files" aria-live="polite">Loading published files…</div>
          </section>

          <section id="upload-panel" class="panel hidden">
            <h2>Submit a File</h2>
            <p>Uploads are sent for publisher review before they become available to all members. Maximum file size: 20 MB.</p>

            <form id="upload-form">
              <div class="field">
                <label for="upload-file">Choose a file</label>
                <input id="upload-file" name="file" type="file" required />
              </div>
              <button id="upload-button" type="submit">Upload for review</button>
            </form>

            <div id="upload-status" class="notice" role="status" aria-live="polite"></div>
          </section>

          <section id="my-submissions-panel" class="panel hidden">
            <h2>Submissions</h2>
            <p>Track pending submissions and remove your own submissions that have not been published.</p>
            <div id="my-submissions">Loading submissions…</div>
          </section>

          <section id="publisher-panel" class="panel wide hidden">
            <h2>Publisher Review</h2>
            <p>Review pending submissions. Publishing makes a file available to all signed-in members.</p>

            <div class="toolbar">
              <button id="refresh-review" type="button">Refresh submissions</button>
            </div>

            <div id="review-list">Loading submissions…</div>
          </section>

          <section id="admin-panel" class="panel wide hidden">
            <h2>Account Management</h2>
            <p>Create member accounts with individual passwords and assign permissions.</p>

            <h3>Create a member account</h3>

            <form id="create-account-form">
              <div class="field">
                <label for="new-name">Member's full name</label>
                <input id="new-name" name="name" required minlength="2" maxlength="100" />
              </div>

              <div class="field">
                <label for="new-username">Username</label>
                <input
                  id="new-username"
                  name="username"
                  required
                  maxlength="100"
                  placeholder="first.last.mathcircle"
                  pattern="[a-z0-9]+([.-][a-z0-9]+)*\.mathcircle"
                />
                <span class="meta">Use lowercase letters and numbers, optionally separated by dots or hyphens, ending in .mathcircle.</span>
              </div>

              <div class="field">
                <label for="new-password">Member's password</label>
                <input
                  id="new-password"
                  name="password"
                  type="password"
                  autocomplete="new-password"
                  required
                  minlength="12"
                  maxlength="256"
                />
                <span class="meta">Use at least 12 characters. Choose a unique password for each member.</span>
              </div>

              <div class="field">
                <label for="confirm-password">Confirm password</label>
                <input
                  id="confirm-password"
                  name="confirmPassword"
                  type="password"
                  autocomplete="new-password"
                  required
                  minlength="12"
                  maxlength="256"
                />
              </div>

              <button id="create-account-button" type="submit">Create account</button>
            </form>

            <div id="create-account-status" class="notice" role="status" aria-live="polite"></div>

            <hr />

            <h3>Manage an existing account's roles</h3>
            <p class="small">Enter the member's exact username. Role changes take effect on the server. This form does not list all accounts automatically because the current Worker has no member-list endpoint.</p>

            <form id="role-form">
              <div class="field">
                <label for="target-username">Member username</label>
                <input id="target-username" required maxlength="100" placeholder="first.last.mathcircle" pattern="[a-z0-9]+([.-][a-z0-9]+)*\.mathcircle" />
              </div>

              <div class="checkrow">
                <input id="role-contributor" type="checkbox" />
                <label for="role-contributor">Contributor — upload and manage own unpublished submissions</label>
              </div>

              <div class="checkrow">
                <input id="role-publisher" type="checkbox" />
                <label for="role-publisher">Publisher — review submissions and manage files</label>
              </div>

              <div class="checkrow">
                <input id="role-admin" type="checkbox" />
                <label for="role-admin">Site administrator — manage accounts and roles</label>
              </div>

              <div class="toolbar">
                <button id="save-roles-button" type="submit">Save selected roles</button>
              </div>
            </form>

            <div id="role-status" class="notice" role="status" aria-live="polite"></div>

            <hr />

            <h3>Activate or deactivate a member</h3>

            <form id="active-form">
              <div class="field">
                <label for="active-username">Member username</label>
                <input id="active-username" required maxlength="100" placeholder="first.last.mathcircle" pattern="[a-z0-9]+([.-][a-z0-9]+)*\.mathcircle" />
              </div>

              <div class="field">
                <label for="active-value">Account status</label>
                <select id="active-value">
                  <option value="true">Active</option>
                  <option value="false">Inactive</option>
                </select>
              </div>

              <button id="save-active-button" type="submit">Update account status</button>
            </form>

            <div id="active-status" class="notice" role="status" aria-live="polite"></div>
          </section>
        </div>

        <div class="logout-area">
          <button id="logout" type="button" class="secondary">Sign out</button>
        </div>
      </section>
    </main>

    <script>
      const API = "https://api.montrealmathcircle.com";
      const statusBox = document.querySelector("#status");
      const portal = document.querySelector("#portal");
      const memberName = document.querySelector("#member-name");
      const roleSummary = document.querySelector("#role-summary");

      let currentMember = null;
      let roles = {
        siteAdministrator: false,
        filePublisher: false,
        fileContributor: false
      };

      async function api(path, options = {}) {
        const response = await fetch(API + path, {
          credentials: "include",
          ...options
        });

        const contentType = response.headers.get("content-type") || "";
        let result = {};

        if (contentType.includes("application/json")) {
          result = await response.json();
        }

        if (!response.ok) {
          throw new Error(result.error || `Request failed (${response.status})`);
        }

        return result;
      }

      function setMessage(id, message) {
        const el = document.querySelector("#" + id);
        if (el) el.textContent = message || "";
      }

      function addText(parent, tag, text, className) {
        const el = document.createElement(tag);
        el.textContent = text ?? "";
        if (className) el.className = className;
        parent.appendChild(el);
        return el;
      }

      function addButton(parent, label, onClick, className = "secondary") {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = label;
        button.className = className;
        button.addEventListener("click", onClick);
        parent.appendChild(button);
        return button;
      }

      function formatSize(bytes) {
        if (!Number.isFinite(Number(bytes))) return "";
        const n = Number(bytes);
        if (n < 1024) return `${n} bytes`;
        if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
        return `${(n / (1024 * 1024)).toFixed(1)} MB`;
      }

      function formatDate(value) {
        if (!value) return "";
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleString();
      }
      
      // IMPORTANT LINKS
      // All signed-in members can view links.
      // Only site administrators can manage them.

      let importantLinks = [];
      let editingLinkId = null;

      function resetLinkForm() {
        editingLinkId = null;

        document.querySelector("#links-form").reset();
        document.querySelector("#links-form-heading").textContent =
          "Add an Important Link";
        document.querySelector("#save-link-button").textContent =
          "Add link";
        document.querySelector("#cancel-link-edit").classList.add("hidden");
      }

      function renderImportantLinks() {
        const list = document.querySelector("#important-links-list");
        list.replaceChildren();

        if (!importantLinks.length) {
          addText(
            list,
            "p",
            "No important links have been added yet.",
            "muted"
          );
          return;
        }

        for (const [index, link] of importantLinks.entries()) {
          const entry = document.createElement("div");
          entry.className = "link-entry";

          const anchor = document.createElement("a");
          anchor.textContent = `${link.title} ↗`;

          try {
            const parsed = new URL(link.url);

            if (["https:", "http:"].includes(parsed.protocol)) {
              anchor.href = parsed.href;
              anchor.target = "_blank";
              anchor.rel = "noopener noreferrer";
            }
          } catch {
            // Invalid links are not clickable.
          }

          entry.appendChild(anchor);

          if (link.description) {
            addText(
              entry,
              "div",
              link.description,
              "link-description"
            );
          }

          if (roles.siteAdministrator) {
            const controls = document.createElement("div");
            controls.className = "link-actions";

            // Edit
            addButton(controls, "Edit", () => {
              editingLinkId = link.id;

              document.querySelector("#link-title").value =
                link.title;
              document.querySelector("#link-url").value =
                link.url;
              document.querySelector("#link-description").value =
                link.description || "";

              document.querySelector("#links-form-heading").textContent =
                "Edit Important Link";
              document.querySelector("#save-link-button").textContent =
                "Save changes";
              document.querySelector("#cancel-link-edit")
                .classList.remove("hidden");

              document.querySelector("#links-admin").scrollIntoView({
                behavior: "smooth",
                block: "nearest"
              });

              document.querySelector("#link-title").focus();
            });

            // Reorder
            async function moveLink(otherIndex) {
              const ids = importantLinks.map(item => item.id);

              [ids[index], ids[otherIndex]] =
                [ids[otherIndex], ids[index]];

              try {
                await api("/important-links/reorder", {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json"
                  },
                  body: JSON.stringify({ ids })
                });

                await loadImportantLinks();
                setMessage("links-status", "Link order updated.");
              } catch (error) {
                setMessage(
                  "links-status",
                  `Could not reorder links: ${error.message}`
                );
              }
            }

            const up = addButton(
              controls,
              "↑ Up",
              () => moveLink(index - 1)
            );
            up.disabled = index === 0;

            const down = addButton(
              controls,
              "↓ Down",
              () => moveLink(index + 1)
            );
            down.disabled = index === importantLinks.length - 1;

            // Delete
            addButton(
              controls,
              "Delete",
              async () => {
                if (!confirm(
                  `Delete important link "${link.title}"?`
                )) return;

                try {
                  await api(
                    `/important-links/${encodeURIComponent(link.id)}`,
                    { method: "DELETE" }
                  );

                  if (editingLinkId === link.id) {
                    resetLinkForm();
                  }

                  await loadImportantLinks();

                  setMessage(
                    "links-status",
                    `Deleted "${link.title}".`
                  );
                } catch (error) {
                  setMessage(
                    "links-status",
                    `Could not delete link: ${error.message}`
                  );
                }
              },
              "danger"
            );

            entry.appendChild(controls);
          }

          list.appendChild(entry);
        }
      }

