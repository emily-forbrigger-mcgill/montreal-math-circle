---
// src/pages/resources.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resources">
    <!-- Main Page Header -->
    <header class="page-header">
        <div class="header-content">
            <span class="meta-tag">[Header Badge / Subtitle]</span>
            <h1>Problem Sets & Materials</h1>
            <p class="subtitle">
                [Insert page intro description / brief overview of materials available here].
            </p>
        </div>
        
        <!-- Search & Filter Bar -->
        <div class="resource-toolbar">
            <div class="search-box">
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" placeholder="Search resources..." aria-label="Search resources" />
            </div>
            <div class="topic-filters">
                <button class="filter-pill active">All Topics</button>
                <button class="filter-pill">[Topic 1]</button>
                <button class="filter-pill">[Topic 2]</button>
                <button class="filter-pill">[Topic 3]</button>
            </div>
        </div>
    </header>

    <!-- Resource Grid -->
    <div class="resource-grid">
        
        <!-- Document Card 1 -->
        <article class="resource-card">
            <div class="card-top">
                <div class="card-badge-row">
                    <span class="session-tag">Week 1</span>
                    <span class="difficulty-badge level-intro">[Level / Tag]</span>
                </div>
                <h3>[Resource Title Placeholder 1]</h3>
                <p>[Insert brief description or topic summary for Week 1 handout here.]</p>
            </div>
            
            <div class="card-meta">
                <span class="file-info">PDF • [File Size]</span>
                <div class="card-actions">
                    <a href="#" class="download-link primary-action">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span>Handout</span>
                    </a>
                    <a href="#" class="download-link secondary-action" title="View Solutions">
                        <span>Solutions</span>
                    </a>
                </div>
            </div>
        </article>

        <!-- Document Card 2 -->
        <article class="resource-card">
            <div class="card-top">
                <div class="card-badge-row">
                    <span class="session-tag">Week 2</span>
                    <span class="difficulty-badge level-inter">[Level / Tag]</span>
                </div>
                <h3>[Resource Title Placeholder 2]</h3>
                <p>[Insert brief description or topic summary for Week 2 handout here.]</p>
            </div>
            
            <div class="card-meta">
                <span class="file-info">PDF • [File Size]</span>
                <div class="card-actions">
                    <a href="#" class="download-link primary-action">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span>Handout</span>
                    </a>
                    <a href="#" class="download-link secondary-action" title="View Solutions">
                        <span>Solutions</span>
                    </a>
                </div>
            </div>
        </article>

        <!-- Document Card 3 -->
        <article class="resource-card">
            <div class="card-top">
                <div class="card-badge-row">
                    <span class="session-tag">Week 3</span>
                    <span class="difficulty-badge level-adv">[Level / Tag]</span>
                </div>
                <h3>[Resource Title Placeholder 3]</h3>
                <p>[Insert brief description or topic summary for Week 3 handout here.]</p>
            </div>
            
            <div class="card-meta">
                <span class="file-info">PDF • [File Size]</span>
                <div class="card-actions">
                    <a href="#" class="download-link primary-action">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span>Handout</span>
                    </a>
                    <a href="#" class="download-link secondary-action" title="View Solutions">
                        <span>Solutions</span>
                    </a>
                </div>
            </div>
        </article>

    </div>

    <!-- Bottom Notice Bar -->
    <section class="archive-notice">
        <div class="notice-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        </div>
        <div class="notice-text">
            <h4>[Notice / Archive Title Placeholder]</h4>
            <p>[Insert note regarding archives, additional materials, or contact info here].</p>
        </div>
    </section>
</Layout>

<style>
    /* Header Section */
    .page-header {
        margin-bottom: 2.25rem;
    }

    .header-content h1 {
        font-size: 2.25rem;
        color: var(--dark);
        margin: 0.6rem 0 0.5rem 0;
        letter-spacing: -0.02em;
    }

    .subtitle {
        font-size: 1.05rem;
        color: var(--text-muted);
        margin: 0 0 1.75rem 0;
        max-width: 720px;
        line-height: 1.5;
    }

    /* Toolbar */
    .resource-toolbar {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.25rem;
    }

    @media (min-width: 768px) {
        .resource-toolbar {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.55rem 0.85rem;
        min-width: 280px;
        color: var(--text-muted);
    }

    .search-box input {
        border: none;
        outline: none;
        background: transparent;
        font-family: var(--font-body);
        font-size: 0.9rem;
        width: 100%;
        color: var(--dark);
    }

    .topic-filters {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
        padding-bottom: 0.25rem;
        scrollbar-width: none;
    }

    .topic-filters::-webkit-scrollbar {
        display: none;
    }

    .filter-pill {
        background: #ffffff;
        border: 1px solid var(--border-color);
        color: #475569;
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 500;
        padding: 0.4rem 0.85rem;
        border-radius: 20px;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .filter-pill:hover, .filter-pill.active {
        background: var(--dark);
        color: #ffffff;
        border-color: var(--dark);
    }

    /* Resource Grid */
    .resource-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    /* Card Styling */
    .resource-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.6rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .resource-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
        border-color: rgba(168, 27, 36, 0.3);
    }

    .card-badge-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.85rem;
    }

    .session-tag {
        background: var(--primary-light);
        color: var(--primary);
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.75rem;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        border: 1px solid rgba(168, 27, 36, 0.15);
    }

    .difficulty-badge {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .level-intro { background: #f0fdf4; color: #166534; }
    .level-inter { background: #fefce8; color: #854d0e; }
    .level-adv   { background: #fef2f2; color: #991b1b; }

    .resource-card h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.18rem;
        color: var(--dark);
        line-height: 1.35;
    }

    .resource-card p {
        color: #475569;
        font-size: 0.92rem;
        margin: 0 0 1.5rem 0;
        line-height: 1.55;
    }

    /* Card Meta & Actions */
    .card-meta {
        border-top: 1px solid var(--border-color);
        padding-top: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .file-info {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
    }

    .card-actions {
        display: flex;
        gap: 0.5rem;
    }

    .download-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        padding: 0.45rem 0.85rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .primary-action {
        background: var(--primary);
        color: #ffffff;
    }

    .primary-action:hover {
        opacity: 0.9;
    }

    .secondary-action {
        background: #f1f5f9;
        color: var(--dark);
        border: 1px solid var(--border-color);
    }

    .secondary-action:hover {
        background: #e2e8f0;
    }

    /* Notice Box */
    .archive-notice {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .notice-icon {
        color: var(--primary);
        background: var(--primary-light);
        padding: 0.6rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .notice-text h4 {
        margin: 0 0 0.2rem 0;
        font-size: 0.95rem;
        color: var(--dark);
    }

    .notice-text p {
        margin: 0;
        font-size: 0.88rem;
        color: var(--text-muted);
    }

    /* Mobile Responsive Overrides */
    @media (max-width: 768px) {
        .header-content h1 {
            font-size: 1.85rem;
        }

        .resource-card {
            padding: 1.25rem;
        }

        .card-meta {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.85rem;
        }

        .card-actions {
            width: 100%;
        }

        .download-link {
            flex: 1;
            justify-content: center;
        }

        .archive-notice {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>