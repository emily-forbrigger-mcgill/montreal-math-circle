---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">

    
    <!-- Our Story Section -->
    <header class="our-story">
        <span class="meta-tag">About Us / Our Mission</span>
        <div class="about-content">
            <div class="story-content">
                <h1>Our Story</h1>
                <p>
                    The Montreal Math Circle (MMC) is a student-run organization that aims to inspire students to flourish with the excitement of mathematical discovery. We are run by a collective of university students and volunteers in the Montreal area, and we offer free math circles for upper elementary, high school, and CEGEP students. Our goal is to create a community where students can explore mathematics in a collaborative and engaging environment, fostering a love for the subject that goes beyond the classroom.
                    <br><br>We believe that students can learn to enjoy mathematics for its own sake, and we are committed to providing opportunities for students to develop their problem-solving skills, critical thinking, and creativity through hands-on activities and discussions. Our math circles are designed to be inclusive and welcoming, encouraging students of all backgrounds and abilities to participate and thrive.
                </p>
            </div>
            <div class="story-content">
                <img src="/mmc-logo-v1.png" alt="Our Story Image" class="story-image">
            </div>
        </div>
    </header>

    <section class=lead-facilitators-section">
        <div class="lf-header">
            <span class="meta-tag">Lead Facilitators</span>
            <h2>Meet the Lead Facilitators</h2>
            <p class="lf-subtitle">Learn more about our founders.</p>
            <article class="lf-card">
                <img src="/team-headshots/aislinn-headshot.png" alt="Headshot of Aislinn Smith" class="lf-headshot"/>
                <div class="lf-info">
                    <h3>Aislinn Smith</h3>
                    <span class="lf-role">Co-Director of MMC, Junior Division</span>
                    <p class="lf-bio">Aislinn is a PhD student in the Department of Mathematics and Statistics at McGill. She is originally from Austin, Texas (Hook 'Em!). She calls her turning point a “math circle-based” course in her junior year of college, which continually inspires her to help students experience the same joy of mathematical discovery she found there.</p>
                    <div class="lf-links">
                        <a href="https://aislinnsmith.com/" target="_blank" class="lf-link"> Website</a>
                    </div>
                </div>
            </article>
            <article class="lf-card">
                <img src="/team-headshots/benji-headshot.jpeg" alt="Headshot of Benjamin Friedman" class="lf-headshot"/>
                <div class="lf-info">
                    <h3>Benjamin Friedman</h3>
                    <span class="lf-role">Co-Director of MMC, Senior Division</span>
                    <p class="lf-bio">Benjamin Friedman is a post-doctoral fellow at Université du Québec à Montréal. His research is in differential geometry, which applies tools like calculus and linear algebra to study the geometry of curved spaces. Benji believes math is a part of culture just like literature or music and is excited to share his enthusiasm for math with others.</em></p>
                    <div class="lf-links">
                        
                    </div>
                </div>
            </article>
        </div>
    </section>

    <!-- Hero / Header Section -->
    <header class="about-quote">
        <div class="quote-content">
            <h1>“We believe that students can learn to enjoy mathematics for its own sake.”</h1>
            <p class="quote-author">- Aislinn Smith, Founder</p>
        </div>
    </header>

    <!-- Mission & Core Values Grid -->
    <section class="about-grid">
        <article class="about-card">
            <div class="card-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
            </div>
            <h3>Our Mission</h3>
            <p>To inspire students to flourish with the excitement of mathematical discovery.</p>
        </article>

        <article class="about-card">
            <div class="card-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <h3>Community & Mentorship</h3>
            <p>We are run by a collective of university students and volunteers in the Montreal area.</p>
        </article>
    </section>


    <!-- Meet the Team Section -->

    <section class="team-section">
        <div class="section-header">
            <span class="meta-tag">Leadership & Mentors</span>
            <h2>Meet the Mentors</h2>
            <p class="section-subtitle">Get to know the dedicated individuals who lead and support our math circle programs.</p>
        </div>

        <div class="team-grid">
            <!-- Team Member 1 -->
            <article class="team-card">
                <img src="" alt="" class="team-headshot"/>
                <div class="team-info">
                    <h3>Jessie Meanwell</h3>
                    <span class="team-role">Head of Operations</span>
                    <p class="team-bio">[Brief bio / academic background / research interests or circle responsibilities].</p>
                </div>
            </article>

            <!-- Team Member 2 -->
            <article class="team-card">
                <img src="/team-headshots/emily-headshot.jpg" alt="Headshot of Emily Forbrigger" class="team-headshot"/>
                <div class="team-info">
                    <h3>Emily Forbrigger</h3>
                    <span class="team-role">Head of Communications</span>
                    <p class="team-bio">Emily (she/her) is an undergraduate physics student with minors in mathematics and English. She has experience teaching in K-12 afterschool math programs.</p>
                </div>
            </article>

            <!-- Team Member 3 -->
            <article class="team-card">
                <img src="" alt="" class="team-headshot"/>
                <div class="team-info">
                    <h3>Hedi Jaza</h3>
                    <span class="team-role">Curriculum Co-Director</span>
                    <p class="team-bio">Hedi holds a Master's degree in Education and Society (Mathematics and Science concentration). He works as a Pedagogical Counsellor at Cégep St. Lawrence.</p>
                </div>
            </article>

             <!-- Team Member 4 -->
            <article class="team-card">
                <img src="" alt="" class="team-headshot"/>
                <div class="team-info">
                    <h3>Minh-Tri Nguyen</h3>
                    <span class="team-role">Curriculum Co-Director</span>
                    <p class="team-bio">Minh-Tri is a Master's student at McGill University in the Department of Integrated Studies in Education.</em></p>
                </div>
            </article>

            <!-- Team Member 5 -->
            <article class="team-card">
                <img src="" alt="" class="team-headshot"/>
                <div class="team-info">
                    <h3>Theodore Simantirakis</h3>
                    <span class="team-role">Instructional Co-Director</span>
                    <p class="team-bio">Theodore (he/him) is a PhD student in the Department of Integrated Studies in Education at McGill University. He is a certified Intermediate-Senior teacher in Ontario with teachables in mathematics and history. His research interests are in math education, math reform, teacher education, and teacher preparation programs.</p>
                </div>
            </article>

             <!-- Team Member 6 -->
            <article class="team-card">
                <img src="" alt="" class="team-headshot"/>
                <div class="team-info">
                    <h3>Harini Narayanan</h3>
                    <span class="team-role">Instructional Co-Director</span>
                    <p class="team-bio">Harini is a PhD candidate in the Department of Integrated Studies in Education (DISE) in the Science and Math Education Research Group (SMERG).</em></p>
                </div>
            </article>
        </div>
    </section>

    <section class="faqs">
        <span class="meta-tag">Frequently Asked Questions</span>
        <details class="toggle-section">
            <summary>What is a math circle?</summary>
            <div class="content">
                <p>A math circle is a learning model that was developed in the mid 20th century Soviet Union with an aim to inspire and train primary and secondary-aged students to excel in mathematical problem solving. Over the years, math circles have expanded to many other locations, iterations, and age-groups.
                    <br><br>If the standard classroom model for teaching mathematics is likened to a theatre play with occasional opportunities for audience participation - then a math circle is improv theatre. In a math circle there is no separation between the performers (teachers/facilitator) and audience (students). In the Montreal Math Circle we ask that students take a front seat in their mathematical exploration - with facilitators there to gently guide and encourage students as they arrive at a rigorous mathematical solution. As facilitators, we believe in the “follow the child” philosophy of teaching mathematics.</p>
            </div>
        </details>

        <details class="toggle-section">
            <summary>How do students learn in MMC?</summary>
            <div class="content">
                <p>Our goal is to have students practice the fundamentals of mathematical problem solving - a skill gained almost entirely through practice. In fact, almost all mathematical formulas featured in this program will be derived by the students - with our gentle guidance.
                    <br><br>When students practice doing this, they will gain the skills and understanding to go beyond prepackaged mathematical tools, and instead be able to create and discover their own toolbox.
                </p>
            </div>
        </details>
    </section>
</Layout>

<style>
    /* Hero Hook Header */
    .about-quote {
        background: #16224A;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 1rem 3rem;
        margin: 0 auto 2rem auto;
        align-self: center;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .quote-content {
        max-width: 800px;
        margin: 0 auto;
        color: var(--primary-light);
    }

    .quote-author{
        font-size: 0.95rem;
        color: var(--primary-light);
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    /* Our Story Header */
    .our-story {
        background: #fff4d050;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 3.5rem 2rem;
        margin-bottom: 2rem;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .about-content {
        max-width: 940px;
        margin: 0 auto;
        display: flex;
        justify-content: flex-start;
        padding: 1rem 1.5rem;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
    }

    .story-content {
        align-content: left;
        text-align: left;
    }

    .story-image {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        place-self: center;
        padding-top: 1rem;
    }

    .our-story h1 {
        font-size: 2.5rem;
        color: var(--dark);
        margin: 0.75rem 0 1rem 0;
        line-height: 1.15;
        letter-spacing: -0.02em;
    }

    .subtitle {
        font-size: 1.1rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin: 0;
    }

    /* About Mission Grid */
    .about-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3.5rem;
    }

    .about-card {
        background: #EEF4FC90;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .card-icon {
        color: var(--primary);
        background: var(--primary-light);
        padding: 0.6rem;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .about-card h3 {
        margin: 0 0 0.6rem 0;
        font-size: 1.25rem;
        color: var(--dark);
    }

    .about-card p {
        color: #2B3858;
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0;
    }

    /* Math Circle History Section */
    .toggle-section {
        background: #FBFCFF;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem 2rem;
        margin-bottom: 1rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    }

    .toggle-section summary {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--dark);
        cursor: pointer;
        outline: none;
    }

    .toggle-section[open] summary {
        color: var(--primary);
    }

    .toggle-section .content {
        margin-top: 1rem;
        font-size: 0.95rem;
        color: #2B3858;
        line-height: 1.55;
    }

    /* Meet the Team Section */

    .lead-facilitators-section {
        margin-bottom: 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .lf-header {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.75rem;
        width: 100%;
        max-width: none;   /* was 1040px */
        margin: 0 auto 2.5rem auto;
        text-align: center;
    }
    .lf-header > h2,
    .lf-header > .lf-subtitle {
        grid-column: 1 / -1;
    }

    .lf-header > .meta-tag {
    grid-column: 1 / -1;
    justify-self: center;
}

    .lf-header h2 {
        font-size: clamp(1.75rem, 3vw, 2.25rem);
        color: var(--dark);
        margin: 0.5rem 0 0 0;
        letter-spacing: -0.02em;
        line-height: 1.15;
    }
    .lf-subtitle {
        color: var(--text-muted);
        font-size: 1rem;
        line-height: 1.6;
        max-width: 560px;
        margin: 0 auto 1.25rem auto;
    }

    /* Card: headshot left, text right */
    .lf-card {
        position: relative;
        display: grid;
        grid-template-columns: 112px 1fr;
        gap: 1.5rem;
        align-items: start;
        text-align: left;
        background: #FBFCFF;
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: 0 4px 18px rgba(43, 56, 88, 0.04);
        overflow: visible;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .lf-card:hover {
        transform: translateY(-4px);
        border-color: #ee9e88;
        box-shadow: 0 12px 30px rgba(43, 56, 88, 0.09);
    }

    .lf-headshot {
        width: 112px;
        height: 112px;
        border-radius: 18px;
        object-fit: cover;
        background: linear-gradient(135deg, #E8F1FC, #F7E4DD);
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px #A9CCF2;
    }
    /* Placeholder when no photo is set yet */
    .lf-headshot[src=""] {
        box-shadow: none;
        border: 2px dashed #A9CCF2;
    }

    .lf-info {
        min-width: 0;
    }
    .lf-info h3 {
        font-size: 1.35rem;
        color: var(--dark);
        margin: 0 0 0.3rem 0;
        letter-spacing: -0.01em;
    }
    .lf-role {
        display: block;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--primary);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 0.9rem;
    }
    .lf-bio {
        font-size: 0.93rem;
        color: #2B3858;
        line-height: 1.65;
        margin: 0 0 1.25rem 0;
    }

    .lf-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        border-top: 1px solid var(--border-color);
        padding-top: 1rem;
        width: 100%;
    }
    /* Hide the divider when a card has no links yet */
    .lf-links:not(:has(a)) {
        display: none;
    }
    .lf-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--dark);
        text-decoration: none;
        padding: 0.4rem 0.9rem;
        border: 1px solid var(--border-color);
        border-radius: 999px;
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
    .lf-link::after {
        content: "↗";
        font-size: 0.8em;
    }
    .lf-link:hover {
        color: var(--primary);
        border-color: #ee9e88;
        background: #fff;
    }
    .lf-link:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 3px;
    }

    @media (max-width: 900px) {
    .lf-header {
        grid-template-columns: 1fr;
        max-width: none;   /* was 620px */
        }
    }
    @media (max-width: 520px) {
        .lf-card {
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
        }
        .lf-links {
            justify-content: center;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .lf-card, .lf-link { transition: none; }
        .lf-card:hover { transform: none; }
    }
    
    .team-section {
        margin-bottom: 4rem;
    }

    .section-header {
        text-align: center;
        max-width: 600px;
        margin: 0 auto 2.5rem auto;
    }

    .section-header h2 {
        font-size: 2rem;
        color: var(--dark);
        margin: 0.5rem 0;
        letter-spacing: -0.01em;
    }

    .section-subtitle {
        color: var(--text-muted);
        font-size: 0.98rem;
        margin: 0;
    }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.75rem;
    }

    .team-card {
        background: #FBFCFF;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .team-card:hover {
        transform: translateY(-3px);
        border-color: #ee9e88;
    }

    .team-headshot {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        border: 2px dashed #A9CCF2;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2B3858;
        font-size: 0.82rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
        object-fit: cover;
    }

    .team-info h3 {
        font-size: 1.18rem;
        color: var(--dark);
        margin: 0 0 0.25rem 0;
    }

    .team-role {
        display: inline-block;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--primary);
        letter-spacing: 0.04em;
        margin-bottom: 0.85rem;
    }

    .team-bio {
        font-size: 0.9rem;
        color: #2B3858;
        line-height: 1.55;
        margin: 0 0 1.25rem 0;
    }

    .team-links {
        border-top: 1px solid var(--border-color);
        padding-top: 0.85rem;
        width: 100%;
    }

    .team-link {
        font-size: 0.85rem;
        color: var(--dark);
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .team-link:hover {
        color: var(--primary);
    }

    .faqs {
        margin: 0 auto 4rem auto;
        display: grid;
    }

    .faqs .meta-tag {
        text-align: center;
        grid-column: 1 / -1;
        justify-self: center;
        margin-bottom: 1.5rem; 
    }

    /* Mobile Overrides */
    @media (max-width: 768px) {
        .our-story {
            padding: 2rem 1.25rem;
        }
        
        .about-content {
            flex-direction: column;
            padding: 1rem 1rem;
            gap: 2rem;
        }
        .our-story h1 {
            font-size: 1.85rem;
        }

        .subtitle {
            font-size: 0.98rem;
        }

        .team-card {
            padding: 1.25rem;
        }
    }
</style>