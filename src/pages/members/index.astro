      // MEMBER DIRECTORY

      let directoryMembers = [];
      let editingDirectoryId = null;

      function resetDirectoryForm() {
        editingDirectoryId = null;
        document.querySelector("#directory-form").reset();
        document.querySelector("#directory-form-heading").textContent =
          "Add a Directory Member";
        document.querySelector("#directory-save").textContent =
          "Add member";
        document.querySelector("#directory-cancel").classList.add("hidden");
      }

      function renderMemberDirectory() {
        const list = document.querySelector("#directory-list");
        list.replaceChildren();

        if (!directoryMembers.length) {
          addText(
            list,
            "p",
            "No members have been added to the directory yet.",
            "muted"
          );
          return;
        }

        for (const [index, member] of directoryMembers.entries()) {
          const entry = document.createElement("div");
          entry.className = "link-entry";

          const name = addText(
            entry,
            "div",
            member.fullName,
            "item-title"
          );
          name.style.color = "#a81b24";

          if (member.memberRole) {
            addText(entry, "div", member.memberRole, "meta");
          }

          if (member.email) {
            const emailLine = document.createElement("div");
            emailLine.className = "meta";

            const emailLink = document.createElement("a");
            emailLink.textContent = member.email;
            emailLink.href = "mailto:" + member.email;
            emailLine.appendChild(emailLink);
            entry.appendChild(emailLine);
          }

          if (member.phone) {
            const phoneLine = document.createElement("div");
            phoneLine.className = "meta";

            const phoneLink = document.createElement("a");
            phoneLink.textContent = member.phone;
            phoneLink.href = "tel:" + member.phone.replace(/[^\d+]/g, "");
            phoneLine.appendChild(phoneLink);
            entry.appendChild(phoneLine);
          }

          if (member.description) {
            addText(
              entry,
              "p",
              member.description,
              "link-description"
            );
          }

          if (roles.siteAdministrator) {
            const actions = document.createElement("div");
            actions.className = "link-actions";

            addButton(actions, "Edit", () => {
              editingDirectoryId = member.id;

              document.querySelector("#directory-name").value =
                member.fullName || "";
              document.querySelector("#directory-role").value =
                member.memberRole || "";
              document.querySelector("#directory-email").value =
                member.email || "";
              document.querySelector("#directory-phone").value =
                member.phone || "";
              document.querySelector("#directory-description").value =
                member.description || "";

              document.querySelector("#directory-form-heading").textContent =
                "Edit Directory Member";
              document.querySelector("#directory-save").textContent =
                "Save changes";
              document.querySelector("#directory-cancel")
                .classList.remove("hidden");

              document.querySelector("#directory-admin").scrollIntoView({
                behavior: "smooth",
                block: "nearest"
              });

              document.querySelector("#directory-name").focus();
            });

            async function moveDirectoryMember(otherIndex) {
              const ids = directoryMembers.map(item => item.id);

              [ids[index], ids[otherIndex]] =
                [ids[otherIndex], ids[index]];

              try {
                await api("/member-directory/reorder", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ ids })
                });

                await loadMemberDirectory();
                setMessage("directory-status", "Directory order updated.");
              } catch (error) {
                setMessage(
                  "directory-status",
                  `Could not reorder directory: ${error.message}`
                );
              }
            }

            const up = addButton(
              actions,
              "↑ Up",
              () => moveDirectoryMember(index - 1)
            );
            up.disabled = index === 0;

            const down = addButton(
              actions,
              "↓ Down",
              () => moveDirectoryMember(index + 1)
            );
            down.disabled = index === directoryMembers.length - 1;

            addButton(
              actions,
              "Delete",
              async () => {
                if (!confirm(
                  `Remove "${member.fullName}" from the directory?`
                )) return;

                try {
                  await api(
                    `/member-directory/${encodeURIComponent(member.id)}`,
                    { method: "DELETE" }
                  );

                  if (editingDirectoryId === member.id) {
                    resetDirectoryForm();
                  }

                  await loadMemberDirectory();
                  setMessage(
                    "directory-status",
                    "Directory member removed."
                  );
                } catch (error) {
                  setMessage(
                    "directory-status",
                    `Could not delete member: ${error.message}`
                  );
                }
              },
              "danger"
            );

            entry.appendChild(actions);
          }

          list.appendChild(entry);
        }
      }

      async function loadMemberDirectory() {
        const list = document.querySelector("#directory-list");

        try {
          const result = await api("/member-directory");
          directoryMembers = result.members || [];
          renderMemberDirectory();
        } catch (error) {
          list.replaceChildren();
          addText(
            list,
            "p",
            `Could not load member directory: ${error.message}`,
            "muted"
          );
        }
      }

      document.querySelector("#directory-cancel")
        .addEventListener("click", resetDirectoryForm);

      document.querySelector("#directory-form")
        .addEventListener("submit", async event => {
          event.preventDefault();

          const data = {
            fullName: document.querySelector("#directory-name").value.trim(),
            memberRole: document.querySelector("#directory-role").value.trim(),
            email: document.querySelector("#directory-email").value.trim(),
            phone: document.querySelector("#directory-phone").value.trim(),
            description:
              document.querySelector("#directory-description").value.trim()
          };

          const wasEditing = editingDirectoryId !== null;
          const path = wasEditing
            ? `/member-directory/${encodeURIComponent(editingDirectoryId)}`
            : "/member-directory";

          const button = document.querySelector("#directory-save");
          button.disabled = true;

          try {
            await api(path, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(data)
            });

            resetDirectoryForm();
            await loadMemberDirectory();

            setMessage(
              "directory-status",
              wasEditing
                ? "Directory member updated."
                : "Directory member added."
            );
          } catch (error) {
            setMessage(
              "directory-status",
              `Could not save directory member: ${error.message}`
            );
          } finally {
            button.disabled = false;
          }
        });

      let folders = [];
      let publishedFiles = [];
      let selectedFolder = "none";

      async function loadPublishedFiles() {
        const container = document.querySelector("#published-files");
        container.replaceChildren();
        addText(container, "p", "Loading published files…", "muted");

        try {
          const [folderResult, fileResult] = await Promise.all([
            api("/files/folders"),
            api("/files/published")
          ]);

          folders = folderResult.folders || [];
          publishedFiles = fileResult.files || [];

          
if (
  selectedFolder !== "none" &&
  selectedFolder !== "all" &&
  selectedFolder !== "unfiled" &&
  !folders.some(f => String(f.id) === selectedFolder)
) {
  selectedFolder = "none";
}


          renderPublishedFiles();
        } catch (error) {
          container.replaceChildren();
          addText(container, "p", `Could not load published files: ${error.message}`, "muted");
        }
      }

      function renderPublishedFiles() {
        const nav = document.querySelector("#folder-navigation");
        const container = document.querySelector("#published-files");
        nav.replaceChildren();
        container.replaceChildren();

        function tile(id, label, count) {
          const button = addButton(nav, `${label} (${count})`, () => {
            selectedFolder = id;
            renderPublishedFiles();
          }, "folder-tile" + (selectedFolder === id ? " selected" : ""));

          button.setAttribute("aria-pressed", String(selectedFolder === id));
        }

        tile("all", "📁 All documents", publishedFiles.length);

        for (const folder of folders) {
          const count = publishedFiles.filter(file =>
            file.folderId != null &&
            Number(file.folderId) === Number(folder.id)
          ).length;

          tile(String(folder.id), `📁 ${folder.name}`, count);
        }

        tile(
          "unfiled",
          "📄 Unfiled Documents",
          publishedFiles.filter(file => file.folderId == null).length
        );

        // Administrator folder management.
        if (
          roles.siteAdministrator &&
          selectedFolder !== "all" &&
          selectedFolder !== "unfiled"
        ) {
          const folder = folders.find(f => String(f.id) === selectedFolder);

          if (folder) {
            const controls = document.createElement("div");
            controls.className = "folder-controls";

            addButton(controls, "Rename this folder", async () => {
              const name = prompt("New folder name:", folder.name);
              if (name === null) return;

              if (!name.trim() || name.trim().length > 80) {
                setMessage("folder-status", "Folder names must be 1–80 characters.");
                return;
              }

              try {
                await api(`/files/folders/${folder.id}`, {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ name: name.trim() })
                });

                setMessage("folder-status", "Folder renamed.");
                await loadPublishedFiles();
              } catch (error) {
                setMessage("folder-status", error.message);
              }
            });

            addButton(controls, "Delete this folder", async () => {
              if (!confirm(
                `Delete folder "${folder.name}"? Its files will become Unfiled; the files will NOT be deleted.`
              )) return;

              try {
                await api(`/files/folders/${folder.id}`, {
                  method: "DELETE"
                });

                selectedFolder = "unfiled";
                setMessage("folder-status", "Folder deleted. Its files are now Unfiled.");
                await loadPublishedFiles();
              } catch (error) {
                setMessage("folder-status", error.message);
              }
            }, "danger");

            container.appendChild(controls);
          }
        }
        if (selectedFolder === "none") {
  addText(
    container,
    "p",
    "Select a folder above to view its documents.",
    "muted"
  );
  return;
}
        const visible = publishedFiles.filter(file =>
          selectedFolder === "all" ||
          (
            selectedFolder === "unfiled" &&
            file.folderId == null
          ) ||
          (
            selectedFolder !== "unfiled" &&
            selectedFolder !== "all" &&
            String(file.folderId) === selectedFolder
          )
        );

        const heading = selectedFolder === "all"
          ? "All Documents"
          : selectedFolder === "unfiled"
            ? "Unfiled Documents"
            : folders.find(f => String(f.id) === selectedFolder)?.name || "Documents";

        addText(container, "h3", heading, "folder-heading");

        if (!visible.length) {
          addText(container, "p", "There are no published documents here yet.", "muted");
          return;
        }

        // Each document has its own compact bordered row.
        for (const file of visible) {
          const card = document.createElement("div");
          card.className = "document-card";

          const filename = file.filename || "Untitled file";

          addText(card, "div", `📄 ${filename}`, "document-title");

          // Small, simple metadata.
          const publishedDate = file.publishedAt
            ? new Date(file.publishedAt)
            : null;

          const dateText = (
            publishedDate &&
            !Number.isNaN(publishedDate.getTime())
          )
            ? publishedDate.toLocaleDateString()
            : "";

          const details = [
            formatSize(file.sizeBytes),
            dateText
          ].filter(Boolean).join(" · ");

          addText(card, "div", details, "document-details");

          const actions = document.createElement("div");
          actions.className = "document-actions";

          // Download button.
          const download = document.createElement("a");
          download.className = "button document-download";
          download.textContent = "Download";
          download.href = `${API}/files/download/${encodeURIComponent(file.id)}`;
          download.setAttribute("aria-label", `Download ${filename}`);
          actions.appendChild(download);

          // File organization and deletion are administrator-only.
          if (roles.siteAdministrator) {
            const adminActions = document.createElement("div");
            adminActions.className = "document-admin-actions";

            const label = document.createElement("label");
            const select = document.createElement("select");
            const selectId = `file-folder-${file.id}`;

            label.htmlFor = selectId;
            label.textContent = "Move to:";
            label.className = "document-move-label";

            select.id = selectId;
            select.className = "document-folder-select";
            select.setAttribute("aria-label", `Folder for ${filename}`);

            const unfiled = document.createElement("option");
            unfiled.value = "";
            unfiled.textContent = "Unfiled";
            select.appendChild(unfiled);

            for (const folder of folders) {
              const option = document.createElement("option");
              option.value = String(folder.id);
              option.textContent = folder.name;
              select.appendChild(option);
            }

            select.value = file.folderId == null
              ? ""
              : String(file.folderId);

            const initial = select.value;

            select.addEventListener("change", async () => {
              select.disabled = true;

              try {
                await api(
                  `/files/submissions/${encodeURIComponent(file.id)}/folder`,
                  {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      folderId: select.value === ""
                        ? null
                        : Number(select.value)
                    })
                  }
                );

                setMessage("folder-status", `Moved "${filename}".`);
                await loadPublishedFiles();
              } catch (error) {
                select.value = initial;
                setMessage(
                  "folder-status",
                  `Could not move file: ${error.message}`
                );
              } finally {
                select.disabled = false;
              }
            });

            adminActions.appendChild(label);
            adminActions.appendChild(select);

            addButton(adminActions, "Delete", async () => {
              if (!confirm(
                `Permanently delete "${filename}"? This cannot be undone.`
              )) return;

              try {
                await api(
                  `/files/submissions/${encodeURIComponent(file.id)}`,
                  { method: "DELETE" }
                );

                setMessage("folder-status", `Deleted "${filename}".`);
                await loadPublishedFiles();
                await loadMySubmissions();
                await loadReviewQueue();
              } catch (error) {
                setMessage(
                  "folder-status",
                  `Could not delete file: ${error.message}`
                );
              }
            }, "document-delete");

            actions.appendChild(adminActions);
          }

          card.appendChild(actions);
          container.appendChild(card);
        }
      }

      async function deleteSubmission(id, statusId, reloadFunction) {
        if (!confirm("Delete this submission? This cannot be undone.")) return;

        try {
          await api(`/files/submissions/${encodeURIComponent(id)}`, {
            method: "DELETE"
          });

          setMessage(statusId, "Submission deleted.");
          await reloadFunction();
          await loadPublishedFiles();
        } catch (error) {
          setMessage(statusId, error.message);
        }
      }

      async function loadMySubmissions() {
        const container = document.querySelector("#my-submissions");
        container.replaceChildren();

        try {
          const result = await api("/files/submissions");
          const submissions = result.submissions || [];

          if (!submissions.length) {
            addText(container, "p", "You have no submissions.", "muted");
            return;
          }

          for (const submission of submissions) {
            const item = document.createElement("div");
            item.className = "item";

            addText(item, "div", submission.filename || "Untitled file", "item-title");
            addText(item, "span", submission.status || "pending", "badge");
            addText(
              item,
              "div",
              `${formatSize(submission.sizeBytes)} · Submitted ${formatDate(submission.createdAt)}`,
              "meta"
            );

            if (submission.status !== "published") {
              addButton(
                item,
                "Delete submission",
                () => deleteSubmission(
                  submission.id,
                  "upload-status",
                  loadMySubmissions
                ),
                "danger"
              );
            }

            container.appendChild(item);
          }
        } catch (error) {
          container.replaceChildren();
          addText(container, "p", error.message, "muted");
        }
      }

      async function loadReviewQueue() {
        const container = document.querySelector("#review-list");
        container.replaceChildren();

        try {
          const result = await api("/files/submissions");
          const submissions = (result.submissions || []).filter(
            submission => submission.status === "pending"
          );

          if (!submissions.length) {
            addText(container, "p", "There are no pending submissions to review.", "muted");
            return;
          }

          for (const submission of submissions) {
            const item = document.createElement("div");
            item.className = "item";

            addText(item, "div", submission.filename || "Untitled file", "item-title");
            addText(
              item,
              "div",
              `Submitted by ${submission.ownerUsername || "unknown"}`,
              "meta"
            );
            addText(
              item,
              "div",
              `${formatSize(submission.sizeBytes)} · ${formatDate(submission.createdAt)}`,
              "meta"
            );

            addButton(item, "Publish", async () => {
              try {
                await api(`/files/submissions/${submission.id}/publish`, {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: "{}"
                });

                setMessage("role-status", "");
                await loadReviewQueue();
                await loadPublishedFiles();
                await loadMySubmissions();
              } catch (error) {
                alert(`Could not publish: ${error.message}`);
              }
            });

            addButton(item, "Reject", async () => {
              if (!confirm("Reject this submission?")) return;

              try {
                await api(`/files/submissions/${submission.id}/reject`, {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: "{}"
                });

                await loadReviewQueue();
                await loadMySubmissions();
              } catch (error) {
                alert(`Could not reject: ${error.message}`);
              }
            }, "secondary");

            addButton(
              item,
              "Delete",
              () => deleteSubmission(
                submission.id,
                "role-status",
                loadReviewQueue
              ),
              "danger"
            );

            container.appendChild(item);
          }
        } catch (error) {
          container.replaceChildren();
          addText(container, "p", error.message, "muted");
        }
      }

      async function checkSession() {
        try {
          const result = await api("/me");

          if (!result.signedIn || !result.member) {
            window.location.replace("/members/login");
            return;
          }

          currentMember = result.member;
          roles = result.roles || roles;

          memberName.textContent = currentMember.name;
          roleSummary.textContent = [
            roles.siteAdministrator ? "Site administrator" : "",
            roles.filePublisher ? "File publisher" : "",
            roles.fileContributor ? "File contributor" : ""
          ].filter(Boolean).join(" · ") || "Member";

          portal.classList.remove("hidden");
          statusBox.textContent = "";

          if (
            roles.siteAdministrator ||
            roles.fileContributor ||
            roles.filePublisher
          ) {
            document.querySelector("#upload-panel").classList.remove("hidden");
            document.querySelector("#my-submissions-panel").classList.remove("hidden");
            await loadMySubmissions();
          }

          if (roles.filePublisher || roles.siteAdministrator) {
            document.querySelector("#publisher-panel").classList.remove("hidden");
            await loadReviewQueue();
          }

          if (roles.siteAdministrator) {
            document.querySelector("#admin-panel").classList.remove("hidden");
            document.querySelector("#folder-admin").classList.remove("hidden");
            document.querySelector("#links-admin").classList.remove("hidden");
            document.querySelector("#directory-admin").classList.remove("hidden");
          }

          
          await Promise.all([
            loadPublishedFiles(),
            loadImportantLinks(),
            loadMemberDirectory()
          ]);

        } catch (error) {
          statusBox.textContent = `Unable to verify your sign-in: ${error.message}`;
        }
      }

      document.querySelector("#refresh-files")
        .addEventListener("click", loadPublishedFiles);

      document.querySelector("#folder-form")
        .addEventListener("submit", async event => {
          event.preventDefault();

          const input = document.querySelector("#folder-name");
          const name = input.value.trim();

          if (!name || name.length > 80) {
            setMessage("folder-status", "Folder names must be 1–80 characters.");
            return;
          }

          try {
            const result = await api("/files/folders", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name })
            });

            input.value = "";
            selectedFolder = String(result.folder.id);
            setMessage("folder-status", `Created folder "${name}".`);
            await loadPublishedFiles();
          } catch (error) {
            setMessage("folder-status", `Could not create folder: ${error.message}`);
          }
        });

      document.querySelector("#refresh-review")
        .addEventListener("click", loadReviewQueue);

      document.querySelector("#upload-form")
        .addEventListener("submit", async event => {
          event.preventDefault();

          const input = document.querySelector("#upload-file");
          const button = document.querySelector("#upload-button");
          const file = input.files && input.files[0];

          if (!file) {
            setMessage("upload-status", "Choose a file first.");
            return;
          }

          if (file.size > 20 * 1024 * 1024) {
            setMessage("upload-status", "The maximum file size is 20 MB.");
            return;
          }

          const form = new FormData();
          form.append("file", file);

          button.disabled = true;
          setMessage("upload-status", "Uploading…");

          try {
            const result = await api("/files/upload", {
              method: "POST",
              body: form
            });

            setMessage(
              "upload-status",
              `Uploaded ${result.submission?.filename || file.name}. It is pending publisher review.`
            );

            input.value = "";
            await loadMySubmissions();
          } catch (error) {
            setMessage("upload-status", `Upload failed: ${error.message}`);
          } finally {
            button.disabled = false;
          }
        });

      document.querySelector("#create-account-form")
        .addEventListener("submit", async event => {
          event.preventDefault();

          const button = document.querySelector("#create-account-button");
          const name = document.querySelector("#new-name").value.trim();
          const username = document.querySelector("#new-username").value.trim().toLowerCase();
          const password = document.querySelector("#new-password").value;
          const confirmPassword = document.querySelector("#confirm-password").value;

          if (password.length < 12) {
            setMessage(
              "create-account-status",
              "The password must be at least 12 characters long."
            );
            return;
          }

          if (password.length > 256) {
            setMessage(
              "create-account-status",
              "The password cannot exceed 256 characters."
            );
            return;
          }

          if (password !== confirmPassword) {
            setMessage(
              "create-account-status",
              "The passwords do not match. Please check them and try again."
            );
            return;
          }

          button.disabled = true;
          setMessage("create-account-status", "Creating account…");

          try {
            const result = await api("/admin/create-member-account", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name, username, password })
            });

            setMessage(
              "create-account-status",
              `Created ${result.name} (${result.username}) with an individual password.`
            );

            document.querySelector("#create-account-form").reset();
          } catch (error) {
            setMessage(
              "create-account-status",
              `Could not create account: ${error.message}`
            );
          } finally {
            button.disabled = false;
          }
        });

      document.querySelector("#role-form")
        .addEventListener("submit", async event => {
          event.preventDefault();

          const button = document.querySelector("#save-roles-button");
          const username = document.querySelector("#target-username").value.trim().toLowerCase();

          const selected = {
            contributor: document.querySelector("#role-contributor").checked,
            publisher: document.querySelector("#role-publisher").checked,
            administrator: document.querySelector("#role-admin").checked
          };

          button.disabled = true;
          setMessage("role-status", "Saving roles…");

          try {
            for (const [field, value] of Object.entries(selected)) {
              const route = field === "contributor"
                ? "/admin/set-file-contributor"
                : field === "publisher"
                  ? "/admin/set-file-publisher"
                  : "/admin/set-site-administrator";

              await api(route, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ username, [field]: value })
              });
            }

            setMessage("role-status", `Saved roles for ${username}.`);

            if (username === currentMember.username) {
              setMessage(
                "role-status",
                "Saved roles for your account. Refresh the page to update the visible controls."
              );
            }
          } catch (error) {
            setMessage(
              "role-status",
              `Role update stopped: ${error.message}. Some earlier role changes may already have been saved. Review the account before trying again.`
            );
          } finally {
            button.disabled = false;
          }
        });

      document.querySelector("#active-form")
        .addEventListener("submit", async event => {
          event.preventDefault();

          const button = document.querySelector("#save-active-button");
          const username = document.querySelector("#active-username").value.trim().toLowerCase();
          const active = document.querySelector("#active-value").value === "true";

          if (!active && username === currentMember.username) {
            if (!confirm(
              "You are about to deactivate your own account and end future access. Continue only if another active administrator can restore access."
            )) {
              return;
            }
          }

          button.disabled = true;
          setMessage("active-status", "Updating account…");

          try {
            await api("/admin/set-member-active", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ username, active })
            });

            setMessage(
              "active-status",
              `Updated ${username}: ${active ? "active" : "inactive"}.`
            );

            if (!active && username === currentMember.username) {
              window.location.replace("/members/login");
            }
          } catch (error) {
            setMessage(
              "active-status",
              `Could not update account: ${error.message}`
            );
          } finally {
            button.disabled = false;
          }
        });

      document.querySelector("#logout")
        .addEventListener("click", async () => {
          const button = document.querySelector("#logout");
          button.disabled = true;

          try {
            await api("/logout", { method: "POST" });
            window.location.replace("/members/login");
          } catch (error) {
            statusBox.textContent = `Sign-out failed: ${error.message}`;
            button.disabled = false;
          }
        });

      checkSession();
    </script>
  </body>
</html>

